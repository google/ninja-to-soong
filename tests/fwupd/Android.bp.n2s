        "-DG_LOG_DOMAIN=\"Fwupd\"",
        "-DLOCALSTATEDIR=\"/data/vendor/fwupd\"",
        "-D_BSD_SOURCE",
        "-D_DARWIN_C_SOURCE=900000",
        "-D_DEFAULT_SOURCE",
