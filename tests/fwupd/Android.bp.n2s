rust_library_rlib {
    name: "libfwupd",
    crate_name: "fwupd",
    srcs: ["rust/fwupd/src/lib.rs"],
    edition: "2021",
    rustlibs: ["libzerocopy"],
    vendor: true,
    compile_multilib: "64",
}

rust_ffi_static {
    name: "libfwupd_ffi",
    crate_name: "fwupd_ffi",
    srcs: ["rust/fwupd-ffi/src/lib.rs"],
    edition: "2021",
    rustlibs: [
        "libfwupd",
        "liblibc",
    ],
    vendor: true,
    compile_multilib: "64",
}

filegroup {
    name: "fwupd_src_conf",
    srcs: ["data/fwupd.conf"],
}

filegroup {
    name: "fwupd_src_pki",
    srcs: [
        "data/pki/LVFS-CA-2025PQ.pem",
        "data/pki/LVFS-CA.pem",
    ],
}

filegroup {
    name: "fwupd_src_vendor_readme",
    srcs: ["data/remotes.d/README.md"],
}

cc_defaults {
    name: "fwupd-defaults",
    // fwupd and its subprojects are built with a newer clang than upstream
    // tests with: keep the warnings, but do not let Soong turn them into
    // errors.
    cflags: [
        "-Wno-alloc-size",
        "-Wno-error",
        "-Wno-incompatible-pointer-types-discards-qualifiers",
        "-Wno-macro-redefined",
        "-Wno-pointer-sign",
    ],
    // Only the three vendor binaries use these modules, and fwupd is only
    // built for 64-bit targets.
    vendor: true,
    compile_multilib: "64",
}
