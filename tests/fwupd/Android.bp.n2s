cc_defaults {
    name: "fwupd-plugin-defaults",
    cflags: [
        "-DFWUPD_COMPILATION",
        "-DG_INTL_STATIC_COMPILATION",
        "-D_BSD_SOURCE",
        "-D_DARWIN_C_SOURCE=900000",
        "-D_DEFAULT_SOURCE",
        "-D_FILE_OFFSET_BITS=64",
        "-D_GNU_SOURCE",
        "-D__BSD_VISIBLE",
        "-Wno-cast-function-type",
        "-Wno-missing-field-initializers",
        "-Wno-missing-noreturn",
        "-Wno-unknown-pragmas",
        "-Wno-unused-parameter",
    ],
    shared_libs: [
        "libbinder_ndk",
        "libz",
