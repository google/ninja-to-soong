python_binary_host {
    name: "fwupd_libfwupdplugin_rustgen_py",
    main: "libfwupdplugin/rustgen.py",
    srcs: ["libfwupdplugin/rustgen.py"],
    data: ["libfwupdplugin/*.in"],
    libs: ["py-jinja"],
    embedded_launcher: false,
}

cc_genrule {
    name: "fwupd_n2s_libfwupdplugin_fu-acpi-table-struct_c",
    cmd: "$(location) $(location libfwupdplugin/fu-acpi-table.rs) --outc $(location n2s/libfwupdplugin/fu-acpi-table-struct.c) --outh $(location n2s/libfwupdplugin/fu-acpi-table-struct.h) --include fwupd.h --prefix Fu",
    srcs: ["libfwupdplugin/fu-acpi-table.rs"],
    out: [
        "n2s/libfwupdplugin/fu-acpi-table-struct.c",
        "n2s/libfwupdplugin/fu-acpi-table-struct.h",
    ],
    tools: ["fwupd_libfwupdplugin_rustgen_py"],
    vendor: true,
